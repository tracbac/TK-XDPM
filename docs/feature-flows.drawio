  <diagram id="cancel-order-uml" name="3 - UML lớp hủy đơn">
    
    
    <mxGraphModel dx="1882" dy="805" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      
      
      <root>
        
        
        <mxCell id="0"/>
        
        
        <mxCell id="1" parent="0"/>
        
        
        <mxCell id="d-title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" value="UML LỚP - HỦY ĐƠN HÀNG" vertex="1">
          
          
