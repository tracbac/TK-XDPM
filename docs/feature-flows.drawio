          <mxGeometry height="1070" width="610" x="490" y="80" as="geometry"/>
          
        
        </mxCell>
        
        
        <mxCell id="d-domain-group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;verticalAlign=top;spacingTop=10;" value="TẦNG LÕI NGHIỆP VỤ (DOMAIN)" vertex="1">
          
          
          <mxGeometry height="430" width="450" x="1120" y="80" as="geometry"/>
          
        
        </mxCell>
        
        
        <mxCell id="d-adapter-group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;verticalAlign=top;spacingTop=10;" value="TẦNG BÊN NGOÀI (ADAPTERS) - KẾT NỐI" vertex="1">
          
          
          <mxGeometry height="490" width="440" x="30" y="670" as="geometry"/>
          
        
        </mxCell>
        
        
        <mxCell id="d-bootstrap-group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontStyle=1;verticalAlign=top;spacingTop=10;" value="ĐIỂM KHỞI TẠO (BOOTSTRAP)" vertex="1">
          
          
          <mxGeometry height="220" width="450" x="1120" y="550" as="geometry"/>
          
        
        </mxCell>
        
        
        <mxCell id="d-view" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#82b366;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;CancelOrderSwingView&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;- controller: CancelOrderSwingController&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ CancelOrderSwingView()&lt;br/&gt;+ setController(controller)&lt;br/&gt;+ display(viewModel)&lt;/div&gt;" vertex="1">
          
          
          <mxGeometry height="150" width="180" x="50" y="150" as="geometry"/>
          
        
        </mxCell>
        
        
        <mxCell id="d-controller" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#82b366;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;CancelOrderSwingController&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;- cancelOrder: CancelOrderInputBoundary&lt;br/&gt;- outputBoundary: CancelOrderOutputBoundary&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ cancelOrder(orderId, reason)&lt;/div&gt;" vertex="1">
          
          
          <mxGeometry height="165" width="190" x="260" y="150" as="geometry"/>
          
        
        </mxCell>
        
        
        <mxCell id="d-presenter" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#82b366;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;CancelOrderSwingPresenter&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;- view: CancelOrderView&lt;br/&gt;- eventPublisher: CancelOrderEventPublisher&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ present(response)&lt;/div&gt;" vertex="1">
          
          
          <mxGeometry height="145" width="180" x="50" y="320" as="geometry"/>
          
        
        </mxCell>
        
        
        <mxCell id="d-viewmodel" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#82b366;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;i&gt;«record»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;CancelOrderViewModel&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;successful: boolean&lt;br/&gt;orderId: String&lt;br/&gt;previousStatus: OrderStatus&lt;br/&gt;orderStatus: OrderStatus&lt;br/&gt;stockReleased: boolean&lt;br/&gt;auditLogged: boolean&lt;br/&gt;message: String&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;&amp;nbsp;&lt;/div&gt;" vertex="1">
          
          
          <mxGeometry height="180" width="190" x="260" y="320" as="geometry"/>
          
        
        </mxCell>
        
        
        <mxCell id="d-event" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=14;strokeWidth=1.5;fillColor=#ffffff;strokeColor=#82b366;" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;CancelOrderEventPublisher&lt;/b&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;- observers: CopyOnWriteArrayList&lt;/div&gt;&lt;hr/&gt;&lt;div style=&quot;text-align:left&quot;&gt;+ addObserver(observer)&lt;br/&gt;+ removeObserver(observer)&lt;br/&gt;+ publish(viewModel)&lt;/div&gt;" vertex="1">
          
          
