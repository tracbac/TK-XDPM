        </mxCell>
        
        
        <mxCell id="d-presentation-group" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;verticalAlign=top;spacingTop=10;" value="TẦNG GIAO DIỆN (PRESENTATION)" vertex="1">
          
          
