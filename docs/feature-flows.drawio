        <mxCell id="d-design-note" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;" value="DESIGN VÀ ĐIỂM MỞ RỘNG&amp;#xa;DDD: Order giữ invariant hủy đơn; Application điều phối. SRP: Controller, UseCase, Domain, Presenter và adapters tách trách nhiệm. DIP/OCP: UseCase phụ thuộc port; thay repository, inventory, audit ở composition root. ISP: port tách theo năng lực; LSP yêu cầu adapter tuân hợp đồng. Patterns: Ports and Adapters, Presenter, Observer. Request / Response tường minh; có thể mở rộng bằng adapter lưu trữ và tồn kho thật." vertex="1">
          
          
          <mxGeometry height="240" width="580" x="510" y="870" as="geometry"/>
          
        
        </mxCell>
        
        
