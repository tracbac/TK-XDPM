  <diagram id="cancel-order-flow" name="1 - Huy don">
    
    
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1150" math="0" shadow="0">
      
      
      <root>
        
        
        <mxCell id="0"/>
        
        
        <mxCell id="1" parent="0"/>
        
        
        <mxCell id="c-title" value="Inventory Management UML" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="180" y="20" width="760" height="40"/>
        </mxCell>
        <mxCell id="inv-service-left" value="&lt;b&gt;InventoryService&lt;/b&gt;&lt;br/&gt;+ getInventory()&lt;br/&gt;+ checkAvailability()&lt;br/&gt;+ reserveStock()&lt;br/&gt;+ releaseStock()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9e8fb;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="100" width="210" height="150"/>
        </mxCell>
        <mxCell id="inv-service-center" value="&lt;b&gt;InventoryService&lt;/b&gt;&lt;br/&gt;- inventoryRepository: InventoryRepository&lt;br/&gt;- stockTransactionService: StockTransactionService&lt;br/&gt;- stockAlertService: StockAlertService&lt;br/&gt;+ updateStock(itemId, quantity)&lt;br/&gt;+ createStockTransaction(type, itemId, quantity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="290" y="80" width="340" height="200"/>
        </mxCell>
        <mxCell id="stock-item" value="&lt;b&gt;StockItem&lt;/b&gt;&lt;br/&gt;- itemId: String&lt;br/&gt;- productName: String&lt;br/&gt;- quantityOnHand: int&lt;br/&gt;- minStockLevel: int&lt;br/&gt;+ adjustQuantity(delta)&lt;br/&gt;+ isLowStock()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="700" y="100" width="230" height="170"/>
        </mxCell>
        <mxCell id="stock-transaction" value="&lt;b&gt;StockTransaction&lt;/b&gt;&lt;br/&gt;- transactionId: String&lt;br/&gt;- type: String&lt;br/&gt;- itemId: String&lt;br/&gt;- quantity: int&lt;br/&gt;- status: String&lt;br/&gt;+ createTransaction()&lt;br/&gt;+ confirmTransaction()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="710" y="350" width="220" height="180"/>
        </mxCell>
        <mxCell id="stock-alert" value="&lt;b&gt;StockAlert&lt;/b&gt;&lt;br/&gt;- alertId: String&lt;br/&gt;- itemId: String&lt;br/&gt;- level: String&lt;br/&gt;- message: String&lt;br/&gt;+ triggerAlert()&lt;br/&gt;+ resolveAlert()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="560" y="600" width="210" height="170"/>
        </mxCell>
        <mxCell id="inventory-store" value="&lt;b&gt;InventoryStore&lt;/b&gt;&lt;br/&gt;+ save(item)&lt;br/&gt;+ load(itemId)&lt;br/&gt;+ getTransactions()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="120" y="340" width="210" height="120"/>
        </mxCell>
        <mxCell id="inventory-report" value="&lt;b&gt;InventoryReport&lt;/b&gt;&lt;br/&gt;+ generateSummary()&lt;br/&gt;+ exportCSV()&lt;br/&gt;+ getLowStockItems()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="280" y="620" width="200" height="130"/>
        </mxCell>
        <mxCell id="c-note" value="Template UML: service layer coordinates domain entities and storage, while supporting classes handle transactions and alerts." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="520" width="220" height="110"/>
        </mxCell>
        <mxCell id="ce1" value="uses" style="endArrow=block;html=1;" edge="1" parent="1" source="inv-service-center" target="stock-item">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce2" value="creates" style="endArrow=block;html=1;" edge="1" parent="1" source="inv-service-center" target="stock-transaction">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce3" value="monitors" style="endArrow=block;html=1;" edge="1" parent="1" source="stock-item" target="stock-alert">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce4" value="persists" style="endArrow=block;html=1;" edge="1" parent="1" source="inv-service-center" target="inventory-store">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce5" value="summarizes" style="endArrow=block;html=1;" edge="1" parent="1" source="inventory-store" target="inventory-report">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce6" value="updates" style="endArrow=block;html=1;" edge="1" parent="1" source="stock-item" target="stock-transaction">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ce7" value="checks" style="endArrow=block;html=1;" edge="1" parent="1" source="inv-service-left" target="inv-service-center">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
      
    
    </mxGraphModel>
    
  
  </diagram>
  
  
